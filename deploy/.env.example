# Kopieren nach /etc/kairos/.env (chmod 600), NICHT ins Repo committen.
# Siehe docs/07-deployment-und-betrieb.md §3.1 (Erstinstallation).

POSTGRES_PASSWORD=changeme
REDIS_PASSWORD=changeme
# 32 zufällige Bytes, base64 -- z.B. `openssl rand -base64 32`. Master Key
# für Envelope-Encryption (Garmin-/Kalender-Credentials). Lebt NUR hier und
# im Passwort-Manager des Betreibers, niemals im Backup (docs/07 §4.1).
KAIROS_KEK=
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
SESSION_SECRET=changeme-32-chars-minimum-here!!
DOMAIN=kairos.example.com
# Ein API-Key fürs gesamte Deployment, geteilt von allen Nutzern -- nicht
# pro Nutzer. Jeder litellm-unterstützte Provider funktioniert.
LLM_API_KEY=
# Optional -- Image-Tag für Rollback/Update (docs/07 §3.2/§3.3). Ohne
# gesetzten Wert wird "dev" verwendet.
GIT_SHA=
